# The 5etools data folder is tracked so extraction works in cloud sessions (DS-1).
data-source/*
!data-source/5etools-src-main/
data-source/5etools-src-main/*
!data-source/5etools-src-main/5etools-src-main/
data-source/5etools-src-main/5etools-src-main/*
!data-source/5etools-src-main/5etools-src-main/data/
node_modules/

# Per-machine Claude Code permissions. Local to this checkout, not shared.
.claude/settings.local.json

# Build output
dist/

# Playwright output (failure screenshots)
test-results/
playwright-report/

# Copied from data/ by scripts/copy-data.js so Vite can serve it.
# data/ at the repo root is the single source of truth and is tracked.
public/data/
